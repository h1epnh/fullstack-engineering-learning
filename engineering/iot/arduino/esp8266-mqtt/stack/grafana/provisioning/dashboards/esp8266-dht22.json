{
  "title": "ESP8266 DHT22",
  "uid": "esp8266-dht22",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Temperature (°C)",
      "type": "timeseries",
      "datasource": "InfluxDB",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperature\")\n  |> filter(fn: (r) => r._field == \"value\")",
          "datasource": "InfluxDB"
        }
      ]
    },
    {
      "id": 2,
      "title": "Humidity (%)",
      "type": "timeseries",
      "datasource": "InfluxDB",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "humidity" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"humidity\")\n  |> filter(fn: (r) => r._field == \"value\")",
          "datasource": "InfluxDB"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
