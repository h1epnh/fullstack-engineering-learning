#pragma once

// Copy this file to config.h and fill in your own values.
// config.h is gitignored so credentials never get committed.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Static IP so the device keeps the same address across reboots.
// Set USE_STATIC_IP to 0 to fall back to DHCP.
#define USE_STATIC_IP 1
#define STATIC_IP 192, 168, 1, 184
#define STATIC_GATEWAY 192, 168, 1, 1
#define STATIC_SUBNET 255, 255, 255, 0
#define STATIC_DNS 192, 168, 1, 1

#define MQTT_BROKER_HOST "192.168.1.10"
#define MQTT_BROKER_PORT 1883
#define MQTT_USERNAME ""   // leave empty if the broker doesn't require auth
#define MQTT_PASSWORD ""
#define MQTT_CLIENT_ID "esp8266-01"
#define MQTT_TOPIC_TEMPERATURE "sensors/esp8266/temperature"
#define MQTT_TOPIC_HUMIDITY "sensors/esp8266/humidity"
#define MQTT_TOPIC_MOTION "sensors/esp8266/motion"

#define DHT_PIN D4
#define DHT_TYPE DHT22

#define PIR_PIN D5

// 3-pin S/+/- relay module. Most of these are active HIGH (S=HIGH -> relay ON).
// Set to 1 if yours turns ON with a LOW signal instead.
#define RELAY_PIN D1
#define RELAY_ACTIVE_LOW 0
#define RELAY_HOLD_MS 30000

#define PUBLISH_INTERVAL_MS 30000
#define MOTION_DEBOUNCE_MS 300

// Message @BotFather to create a bot and get a token; message your bot once,
// then GET https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
#define TELEGRAM_BOT_TOKEN "your-bot-token"
#define TELEGRAM_CHAT_ID "your-chat-id"

// 16x2 I2C LCD. D1/D2 are already used (relay/DHT), so I2C uses D6/D7 instead
// of the ESP8266's usual default I2C pins.
#define LCD_SDA_PIN D6
#define LCD_SCL_PIN D7
#define LCD_I2C_ADDRESS 0x27
#define LCD_DATETIME_DURATION_MS 10000 // how long the date/time page shows before switching
#define LCD_SENSOR_DURATION_MS 3000    // how long the sensor page shows before switching back

// Vietnam is UTC+7, no daylight saving. Adjust for your own timezone.
#define NTP_TIMEZONE_OFFSET_SEC (7 * 3600)
#define NTP_SERVER "pool.ntp.org"

// 0.9" OLED, 128x64, SSD1306 driver. Shares the same I2C bus/pins as the LCD
// above (D6/D7) — fine since it's a different I2C address (0x3C vs the LCD's
// 0x27/0x3F). Shows a motion-reactive face (awake/asleep), independent of
// the LCD.
#define OLED_I2C_ADDRESS 0x3C
#define OLED_WIDTH 128
#define OLED_HEIGHT 64
