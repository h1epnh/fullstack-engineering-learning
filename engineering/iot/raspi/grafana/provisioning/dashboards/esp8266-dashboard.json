{
  "title": "ESP8266 Sensors",
  "uid": "esp8266-sensors",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Temperature (°C)",
      "type": "timeseries",
      "datasource": "InfluxDB",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperature\")\n  |> filter(fn: (r) => r._field == \"value\")",
          "datasource": "InfluxDB"
        }
      ]
    },
    {
      "id": 2,
      "title": "Humidity (%)",
      "type": "timeseries",
      "datasource": "InfluxDB",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "humidity" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"humidity\")\n  |> filter(fn: (r) => r._field == \"value\")",
          "datasource": "InfluxDB"
        }
      ]
    },
    {
      "id": 3,
      "title": "Motion (1=detected)",
      "type": "state-timeline",
      "datasource": "InfluxDB",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"motion\")\n  |> filter(fn: (r) => r._field == \"value\")",
          "datasource": "InfluxDB"
        }
      ]
    },
    {
      "id": 4,
      "title": "Motion right now",
      "type": "stat",
      "datasource": "InfluxDB",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Clear" }, "1": { "text": "Motion" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensors\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"motion\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> last()",
          "datasource": "InfluxDB"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
